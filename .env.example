# GradMate environment template
# Copy this file to .env and fill only the services you intend to use.

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Model provider: configure either ARK or another OpenAI-compatible endpoint.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_ID=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

MODEL_TEMPERATURE=0.3
MODEL_TIMEOUT_SECONDS=90

# Runtime workspace (relative paths are resolved from backend/)
WORK_ROOT=workspace
WORD_REPORTS_DIR=workspace/word_reports
SCREENSHOTS_DIR=workspace/screenshots
SYSTEM_PROMPT_FILE=system_prompt.md

# Admission deadline data
BAOYAN_DDL_SOURCE_URL=https://raw.githubusercontent.com/CS-BAOYAN/CS-BAOYAN-DDL/main/src/data/schools.json
BAOYAN_DDL_CACHE_TTL_SECONDS=1800

# Browser research. Leave CHROMEDRIVER_PATH empty to use Selenium Manager.
CHROMEDRIVER_PATH=
CHROME_BINARY_PATH=
BROWSER_HEADLESS=true
BROWSER_MAX_PAGES=12
BROWSER_SEARCH_URL_TEMPLATE=https://www.bing.com/search?q={query}
BROWSER_LLM_ASSIST=true
BROWSER_LLM_EXTRACT=true
BROWSER_LLM_MAX_RECORDS=5
BROWSER_LLM_TEXT_LIMIT=6000
BROWSER_LLM_EXTRACT_MAX_PAGES=3
BROWSER_FINAL_SUPERVISOR_LIMIT=5

# Optional public school-directory workbook
SCHOOL_DIRECTORY_FILE=../GradMate_软科Top40计算机院系官网.xlsx

# SMTP. Use an application password/authorization code, not your login password.
# Sending is disabled unless this explicit opt-in is enabled.
EMAIL_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GradMate
SMTP_REPLY_TO=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=20

# Optional read-only practice question bank
PRACTICE_NEO4J_URI=
PRACTICE_NEO4J_USER=neo4j
PRACTICE_NEO4J_PASSWORD=
